{#
  Sommaire flottant : construit côté client à partir des titres h2/h3 de l'article.
  - ajoute un id aux titres qui n'en ont pas (pour pouvoir y faire des liens) ;
  - ignore les titres placés dans des blocs repliables (<details>) ;
  - n'affiche rien s'il y a moins de deux titres (les flèches restent alors dans l'entête) ;
  - déplace les flèches haut/bas de l'entête à droite du bouton du sommaire.
  Le script s'exécute avant MathJax : les formules des titres sont donc aussi rendues dans le sommaire.
#}
<script>
  (function () {
    const article = document.querySelector("main article");
    if (!article) return;

    const headings = Array.from(article.querySelectorAll("h2, h3"))
      .filter((h) => !h.closest("details"));
    if (headings.length < 2) return;

    const used = new Set(Array.from(document.querySelectorAll("[id]"), (e) => e.id));
    function slug(text) {
      let base = text.normalize("NFD").replace(/[̀-ͯ]/g, "")
        .toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "") || "section";
      let id = base, i = 2;
      while (used.has(id)) id = base + "-" + i++;
      used.add(id);
      return id;
    }

    const nav = document.createElement("nav");
    nav.id = "toc";
    nav.setAttribute("aria-label", "Sommaire");

    const button = document.createElement("button");
    button.type = "button";
    button.id = "toc-toggle";
    button.title = "Sommaire";
    button.setAttribute("aria-expanded", "false");
    button.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="20" height="20"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zM3.75 12h.007v.008H3.75V12zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm-.375 5.25h.007v.008H3.75v-.008zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"/></svg><span>Sommaire</span>';

    const list = document.createElement("ol");
    list.id = "toc-list";

    const links = [];
    headings.forEach((h) => {
      if (!h.id) h.id = slug(h.textContent);
      const li = document.createElement("li");
      li.className = "toc-" + h.tagName.toLowerCase();
      const a = document.createElement("a");
      a.href = "#" + h.id;
      a.className = "toc-link";
      // copie du contenu du titre (formules comprises), sans liens imbriqués
      const clone = h.cloneNode(true);
      clone.querySelectorAll("a").forEach((inner) => inner.replaceWith(...inner.childNodes));
      a.append(...clone.childNodes);
      li.appendChild(a);
      list.appendChild(li);
      links.push(a);
    });

    // les flèches haut/bas de l'entête sont déplacées à droite du bouton du sommaire
    const bar = document.createElement("div");
    bar.id = "toc-bar";
    bar.append(button);
    document.querySelectorAll("header button[onclick]").forEach((b) => {
      b.classList.add("toc-arrow");
      bar.append(b);
    });

    nav.append(bar, list);
    document.body.appendChild(nav);

    const wide = window.matchMedia("(min-width: 1700px)");
    function setOpen(open) {
      nav.classList.toggle("open", open);
      button.setAttribute("aria-expanded", String(open));
    }
    setOpen(false);
    button.addEventListener("click", () => setOpen(!nav.classList.contains("open")));
    list.addEventListener("click", (e) => {
      if (e.target.closest("a") && !wide.matches) setOpen(false);
    });

    // mise en évidence de la section courante
    function update() {
      let current = 0;
      headings.forEach((h, i) => {
        if (h.getBoundingClientRect().top < 100) current = i;
      });
      links.forEach((a, i) => a.classList.toggle("active", i === current));
    }
    let ticking = false;
    window.addEventListener("scroll", () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(() => { update(); ticking = false; });
      }
    }, { passive: true });
    update();
  })();
</script>
